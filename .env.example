# Copy to .env for local runs. In production, put secrets in AWS Secrets
# Manager / GCP Secret Manager, never in the image.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres@127.0.0.1:5432/reservo
DB_POOL_MAX=10

# Platform host (payment callbacks land here) and the domain for studio subdomains
PUBLIC_BASE_URL=http://localhost:3000
PLATFORM_DOMAIN=localhost

# 32 random bytes, base64. Encrypts studios' payment keys. Never change it
# without re-encrypting (see docs/OPERATIONS.md).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Bearer token for POST /internal/cron
CRON_SECRET=

# 1 behind a load balancer (ALB, Cloud Run), 0 when hit directly
TRUST_PROXY_HOPS=0
# Run background jobs inside the web process (fine for one instance)
INLINE_WORKER=true
ALLOW_MOCK_PAYMENTS=true

# Messages: log (prints only) | brevo | meta
EMAIL_PROVIDER=log
SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
BREVO_API_KEY=
EMAIL_FROM=reservas@reservo.pt
SMS_SENDER=Reservas
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
WA_TEMPLATE_CONFIRM=booking_confirmed
WA_TEMPLATE_REMINDER=booking_reminder
WA_TEMPLATE_LANG=pt_PT

# ifthenpay
IFTHENPAY_BASE_URL=https://api.ifthenpay.com
IFTHENPAY_MB_SANDBOX=false

CUSTOMER_RETENTION_MONTHS=24
