{
  "name": "reservo",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant website + booking + MB WAY/Multibanco payments for massage studios and spas in Portugal",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.ts",
    "worker": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/worker.ts",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.ts",
    "migrate": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/migrate.ts",
    "seed:demo": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/seed-demo.ts",
    "tenant:create": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/create-tenant.ts",
    "demo:export": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/export-demo.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0"
  }
}
